# Amaenetes: a scheduler written in Amae.
#
# With KUBE_CONTEXT set, it is the scheduler of that cluster. It looks at the
# cluster through kubectl, works out in Amae who could live where, lets
# the pods and the nodes find each other, binds every pod to the node it
# settled on, and looks again. Pods choose it with schedulerName:
# amaenetes (or AMAENETES_NAME). It looks every AMAENETES_INTERVAL
# seconds (5 if not set) and, if AMAENETES_LOOKS is set, rests after
# that many looks. With AMAENETES_LEASE set to namespace/name, several
# copies may run and only the one holding that lease binds; the others
# wait for it to stop renewing. Every pod it binds, and every pod it finds
# nowhere to live for, gets an Event, as kube-scheduler gives them.
#
# Without it, the world tells it about a cluster on standard input, either
# as the cluster itself (two lines: `kubectl get nodes -o json` and
# `kubectl get pods -A -o json`, each on one line) or as preferences, one
# soul per line:
#     pod web alpha beta gamma        the nodes web would live on, best first
#     node alpha 2 db cache web       how many pods alpha can take, and whom it prefers
# and it says where everyone would live.
#
# Who may meet whom is decided the way kube-scheduler decides it: a pod
# likes only the nodes it fits on (resources counted as the kubelet counts
# them, extended resources such as GPUs among them, node selector, required
# node affinity, taints it tolerates, free host ports), and a node offers
# only as many seats as it can hold of the largest pod that wants it. A node
# annotated amaenetes.io/seats: "N" hosts at most N pods of this scheduler.
#
# Preferences:
#   pod annotation  amaenetes.io/likes: "node-a node-b"   nodes it wants first
#   node annotation amaenetes.io/likes: "ns/pod ns/pod"   pods it wants first
# then the nodes its preferred node affinity leans to, then the nodes its
# workload trusts more (fewer scars, a healthier relationship, as counsel
# keeps them; twice as much for a pod with priority), then the nodes with
# more free whole cores; where the nodes are equal every pod has its own
# lasting taste, so a crowd of identical pods spreads out. Nodes prefer pods
# with higher priority, then the ones waiting longest.
#
# A pod proposes to the nodes it likes, in order. A node keeps the best pods
# that have asked so far, says no to the rest and, when someone better comes
# while it is full, tells the least wanted pod to go and wounds it in parting.
# A pod gives its heart to the node that takes it, so the wound leaves a scar
# but does not close it to the next node.
#
# Nobody compares the cluster with a desired state. When every soul is
# waiting and nobody has anything left to say, the cluster hears the silence,
# asks every pod where it lives and lets everyone rest. That silence is a
# stable matching. The nodes stay: every look at the cluster is one more
# meeting with them. The pods of one look are souls of that look.
#
# Everything that has to survive a wait is written down with note:
# a soul that waits forgets, and a scheduler that forgets loses its pods.

written by "amae"

# Infrastructure lives the same life every run: no chemistry.
deterministic

learn "kube.amae"

# Being handed something by the cluster, and thanking it, so that the
# cluster never says too much unanswered.
ritual accept_gift
    hear cluster into gift
    note "gift" = gift
    tell cluster "thank you"
    give back note "gift"
end

# Handing something over and waiting for the thanks. Waiting is long
# enough to forget, so what is handed over is written down first.
ritual hand_over who, what
    note "to" = who
    note "handed" = what
    tell soul named note "to" note "handed"
    hear soul named note "to" into thanks
end

# Meeting everyone on a list, in the order of the list. The place in the list
# is kept in a note: every meeting is a wait.
ritual meet_everyone list
    note "meeting" = 1
    while note "meeting" <= words of note list
        meet soul named word (note "meeting") of note list
        note "meeting" = note "meeting" + 1
    end
end

# The words of a line from the n-th on.
ritual words_from line, n
    let rest = ""
    let i = n
    while i <= words of line
        rest = rest + " " + word i of line
        i = i + 1
    end
    give back rest
end

# Meeting every node the cluster knows once more, to say farewell.
ritual farewell
    note "handing" = 1
    while note "handing" <= words of note "known nodes"
        meet soul named word (note "handing") of note "known nodes"
        perform hand_over with word (note "handing") of note "known nodes", "farewell"
        note "handing" = note "handing" + 1
    end
end

# A pod's name without the look it belongs to.
ritual shown name
    let i = 1
    while i <= length of name
        if name[i] == "#"
            give back part 1 (i - 1) of name
        end
        i = i + 1
    end
    give back name
end

kind pod
    perform shown with me into name
    note "me" = name
    meet cluster
    perform accept_gift into likes
    note "likes" = likes
    perform accept_gift into nodes
    note "nodes" = nodes
    perform meet_everyone with "nodes"
    note "k" = 1
    while note "k" <= words of note "likes"
        note "there" = word (note "k") of note "likes"
        tell soul named note "there" me
        hear soul named note "there" into answer
        if answer == "yes"
            give heart to soul named note "there"
            say note "me" + " settles on " + note "there"
            mark settled
            hear anyone into news from who
            if who == "cluster"
                if news == "rest"
                    goodbye
                end
                tell cluster note "there"
                return to settled
            end
            say note "me" + " is sent away from " + note "there"
        end
        note "k" = note "k" + 1
    end
    say note "me" + " has nowhere to live"
    mark homeless
    hear cluster into question
    if question == "rest"
        goodbye
    end
    tell cluster "nowhere"
    return to homeless
end

# A node lives as long as the scheduler does. Every look at the cluster it is
# part of begins with a meeting, which brings the two closer again after the
# time apart, then what it can take now and whom it would have.
kind node
    mark looking
    meet cluster
    perform accept_gift into seats
    if seats == "farewell"
        goodbye
    end
    note "seats" = number of ("" + seats)
    perform accept_gift into likes
    note "likes" = likes
    perform accept_gift into pods
    note "pods" = pods
    perform meet_everyone with "pods"
    note "held" = 0
    mark attentive
    hear anyone into asking from who
    if who == "cluster"
        return to looking
    end
    note "who" = who
    note "rank" = place of who in note "likes"
    if note "rank" == 0 or note "seats" == 0
        tell soul named note "who" "no"
        return to attentive
    end
    if note "held" < note "seats"
        tell soul named note "who" "yes"
        warm to soul named note "who"
        note "held" = note "held" + 1
        return to attentive
    end
    let j = words of note "likes"
    while trust soul named word j of note "likes" != 1
        j = j - 1
    end
    if j < note "rank"
        tell soul named note "who" "no"
        return to attentive
    end
    note "out" = word j of note "likes"
    tell soul named note "who" "yes"
    warm to soul named note "who"
    cool to soul named note "out"
    tell soul named note "out" "go"
    knowingly wound soul named note "out"
    return to attentive
end

# One look: the pods in note "pods" and the nodes in note "nodes" find each
# other, with what each likes in note ("likes " + name) and the seats of the
# nodes in note ("seats " + name). Where every pod lives goes to
# note ("home " + pod): a node, or "nowhere".
ritual match
    note "i" = 1
    while note "i" <= words of note "pods"
        bring pod named word (note "i") of note "pods"
        note "i" = note "i" + 1
    end
    note "i" = 1
    while note "i" <= words of note "nodes"
        note "n" = word (note "i") of note "nodes"
        if place of note "n" in note "known nodes" == 0
            bring node named note "n"
            note "known nodes" = note "known nodes" + " " + note "n"
        end
        meet soul named note "n"
        note "i" = note "i" + 1
    end

    note "i" = 1
    while note "i" <= words of note "pods"
        note "p" = word (note "i") of note "pods"
        meet soul named note "p"
        perform hand_over with note "p", note ("likes " + note "p")
        perform hand_over with note "p", note "nodes"
        note "i" = note "i" + 1
    end
    note "i" = 1
    while note "i" <= words of note "nodes"
        note "n" = word (note "i") of note "nodes"
        perform hand_over with note "n", note ("seats " + note "n")
        perform hand_over with note "n", note ("likes " + note "n")
        perform hand_over with note "n", note "pods"
        note "i" = note "i" + 1
    end

    wait for silence

    note "i" = 1
    while note "i" <= words of note "pods"
        note "p" = word (note "i") of note "pods"
        tell soul named note "p" "where do you live?"
        hear soul named note "p" into home
        note ("home " + note "p") = home
        tell soul named note "p" "rest"
        note "i" = note "i" + 1
    end
    note "i" = 1
    while note "i" <= words of note "nodes"
        tell soul named word (note "i") of note "nodes" "rest"
        note "i" = note "i" + 1
    end
end

# The relationships counsel keeps (amae.io/v1), by namespace, partner
# and node.
ritual bonds_of all
    let bonds = {}
    let i = 1
    while i <= length of all
        let r = all[i]
        perform field with r["spec"], "kind", "" into kind_
        if kind_ != "quarrel"
            perform field with r, "status", {} into st
            let partner = r["spec"]["partner"]
            bonds[r["metadata"]["namespace"] + " " + partner["kind"] + "/" + partner["name"] + " " + r["spec"]["node"]] = st
        end
        recall all bonds
        i = i + 1
    end
    give back bonds
end

# How little a pod's workload should trust a node, from what they have
# lived through: every scar counts, an at-risk relationship counts three
# more and a failing one ten. A pod that matters (priority above zero)
# counts it twice: where a pod has fallen, less of what matters goes.
ritual distrust pod, nn, bonds
    if length of bonds == 0
        give back 0
    end
    perform partner_of with pod into partner
    let key_ = pod["metadata"]["namespace"] + " " + partner["kind"] + "/" + partner["name"] + " " + nn
    if place of key_ in bonds == 0
        give back 0
    end
    let st = bonds[key_]
    perform field with st, "scars", 0 into wary
    perform field with st, "health", "" into health
    if health == "at risk"
        wary = wary + 3
    end
    if health == "failing"
        wary = wary + 10
    end
    perform field with pod["spec"], "priority", 0 into priority
    if priority > 0
        wary = wary * 2
    end
    give back wary
end

# The cluster as kubectl tells it, made into a look: who may meet whom, in
# what order, and how many seats every node has. Pods are named ns/name.
ritual describe all_nodes, all_pods, scheduler, spaces, bonds
    note "bonds" = bonds
    let free = {}
    let ports = {}
    let ours = {}
    let residents = {}
    let machines = {}
    let dying = {}
    let placed = []
    let guarded = []
    let up_nodes = []
    let i = 1
    while i <= length of all_nodes
        perform ready with all_nodes[i] into up
        if up
            let name = all_nodes[i]["metadata"]["name"]
            put all_nodes[i] into up_nodes
            perform allocatable with all_nodes[i] into left
            free[name] = left
            ports[name] = ""
            ours[name] = 0
            residents[name] = []
            machines[name] = all_nodes[i]
            dying[name] = 0
        end
        recall all_nodes all_pods scheduler free ports ours up_nodes residents machines dying placed guarded spaces bonds
        i = i + 1
    end

    let pending = []
    i = 1
    while i <= length of all_pods
        let p = all_pods[i]
        perform field with p["spec"], "nodeName", "" into where
        perform field with p["status"], "phase", "" into stage
        perform field with p["spec"], "schedulerName", "" into chosen
        if where != "" and place of where in free > 0 and stage != "Succeeded" and stage != "Failed"
            perform requests with p into r
            perform take_away with free[where], r into left
            free[where] = left
            perform host_ports with p into hp
            ports[where] = ports[where] + hp
            if chosen == scheduler
                ours[where] = ours[where] + 1
            end
            put p into residents[where]
            put {"pod": p, "node": where} into placed
            perform pod_terms with p, "podAntiAffinity", "required" into shuns
            if length of shuns > 0
                put {"pod": p, "node": where} into guarded
            end
            perform field with p["metadata"], "deletionTimestamp", "" into going
            if going != ""
                dying[where] = dying[where] + 1
            end
        end
        perform field with p["metadata"], "deletionTimestamp", "" into going
        if where == "" and stage == "Pending" and going == "" and chosen == scheduler
            put p into pending
        end
        recall all_nodes all_pods scheduler free ports ours up_nodes pending residents machines dying placed guarded spaces bonds
        i = i + 1
    end

    # Who fits where, and why not.
    let around = {"placed": placed, "guarded": guarded, "machines": machines, "spaces": spaces}
    let pods = ""
    let objects = {}
    let wants = {}
    let fits = {}
    let why = {}
    i = 1
    while i <= length of pending
        let p = pending[i]
        let pn = p["metadata"]["namespace"] + "/" + p["metadata"]["name"]
        pods = pods + " " + pn
        objects[pn] = p
        perform requests with p into r
        wants[pn] = r
        perform sociable with p into social
        let reasons = {}
        let j = 1
        while j <= length of up_nodes
            let nn = up_nodes[j]["metadata"]["name"]
            perform unfit with p, up_nodes[j], r, free[nn], ports[nn] into reason
            if reason == "" and (length of guarded > 0 or social)
                perform crowded with p, up_nodes[j], around into reason
            end
            fits[pn + " " + nn] = reason == ""
            if reason != ""
                if place of reason in reasons == 0
                    reasons[reason] = 0
                end
                reasons[reason] = reasons[reason] + 1
            end
            recall p pn r reasons social i pending up_nodes free ports ours pods objects wants fits why all_nodes residents machines dying placed guarded spaces around bonds
            j = j + 1
        end
        why[pn] = reasons
        recall pending up_nodes free ports ours pods objects wants fits why all_nodes residents machines dying placed guarded spaces around bonds
        i = i + 1
    end

    # What every pod likes, best first.
    let likes = {}
    i = 1
    while i <= words of pods
        let pn = word i of pods
        perform annotation with objects[pn], "amaenetes.io/likes" into wanted
        let candidates = []
        let order = []
        let j = 1
        while j <= length of up_nodes
            let nn = up_nodes[j]["metadata"]["name"]
            perform recently_refused with pn, nn into refused
            if fits[pn + " " + nn] and not refused
                let rank = place of nn in wanted
                if rank == 0
                    rank = words of wanted + 1
                end
                perform leaning with objects[pn], up_nodes[j] into lean
                perform sociable with objects[pn] into social
                if social
                    perform drawn with objects[pn], up_nodes[j], around into pull
                    lean = lean + pull
                end
                perform field with free[nn], "cpu", 0 into cores
                perform distrust with objects[pn], nn, bonds into wary
                put nn into candidates
                put [rank, 0 - lean, wary, 0 - cores / 1000, hash of ("pod:" + pn + " node:" + nn)] into order
            end
            recall pn wanted candidates order i pods objects up_nodes free fits likes ours wants why all_nodes residents machines dying ports placed guarded spaces around bonds
            j = j + 1
        end
        perform sorted with candidates, order into best
        let line = ""
        j = 1
        while j <= length of best
            line = line + " " + best[j]
            recall best line pn i pods objects up_nodes free fits likes ours wants why all_nodes residents machines dying ports placed guarded spaces around bonds
            j = j + 1
        end
        likes[pn] = line
        recall pods objects up_nodes free fits likes why all_nodes residents machines dying ports placed guarded spaces around bonds
        i = i + 1
    end

    # Whom every node prefers, and how many it can take.
    let nodes = ""
    let seats = {}
    i = 1
    while i <= length of up_nodes
        let node = up_nodes[i]
        let nn = node["metadata"]["name"]
        nodes = nodes + " " + nn
        perform annotation with node, "amaenetes.io/likes" into wanted
        let suitors = []
        let order = []
        let j = 1
        while j <= words of pods
            let pn = word j of pods
            if fits[pn + " " + nn]
                let rank = place of pn in wanted
                if rank == 0
                    rank = words of wanted + 1
                end
                perform field with objects[pn]["spec"], "priority", 0 into priority
                put pn into suitors
                put [rank, 0 - priority, objects[pn]["metadata"]["creationTimestamp"], pn] into order
            end
            recall node nn wanted suitors order i up_nodes pods objects wants fits free ours nodes seats likes why all_nodes residents machines dying ports placed guarded spaces around bonds
            j = j + 1
        end
        perform sorted with suitors, order into best
        let line = ""
        let left = free[nn]
        perform field with left, "pods", 0 into room
        perform annotation with node, "amaenetes.io/seats" into limit
        if limit != ""
            if number of limit - ours[nn] < room
                room = number of limit - ours[nn]
            end
        end
        j = 1
        while j <= length of best
            line = line + " " + best[j]
            let r = wants[best[j]]
            let names = keys of r
            let k = 1
            while k <= length of names
                if r[names[k]] > 0
                    perform field with left, names[k], 0 into has
                    if has / r[names[k]] < room
                        room = has / r[names[k]]
                    end
                end
                recall r names left room j best line node nn i up_nodes pods objects wants fits free ours nodes seats likes why all_nodes residents machines dying ports placed guarded spaces around bonds
                k = k + 1
            end
            recall best line left room node nn i up_nodes pods objects wants fits free ours nodes seats likes why all_nodes residents machines dying ports placed guarded spaces around bonds
            j = j + 1
        end
        if room < 0
            room = 0
        end
        likes[nn] = line
        seats[nn] = room
        recall up_nodes pods objects wants fits free ours nodes seats likes why all_nodes residents machines dying ports placed guarded spaces around bonds
        i = i + 1
    end
    give back {"pods": pods, "nodes": nodes, "likes": likes, "seats": seats, "objects": objects, "why": why, "count": length of all_nodes, "down": length of all_nodes - length of up_nodes, "wants": wants, "free": free, "ports": ports, "residents": residents, "machines": machines, "dying": dying, "around": around}
end

# Forget expired node refusals and pods with no refusals left.
ritual prune_refused
    let refused = note "refused"
    let pods = keys of refused
    let i = 1
    while i <= length of pods
        let pn = pods[i]
        let refused = note "refused"
        let nodes = refused[pn]
        let names = keys of nodes
        let j = 1
        while j <= length of names
            let nn = names[j]
            if note "looks" - nodes[nn] > 6
                remove nn from nodes
            end
            recall pods i pn nodes names
            j = j + 1
        end
        let refused = note "refused"
        if length of nodes == 0
            remove pn from refused
        else
            refused[pn] = nodes
        end
        note "refused" = refused
        recall pods
        i = i + 1
    end
end

# A refusal excludes this node for the next six looks, even silent ones.
ritual recently_refused pn, nn
    let refused = note "refused"
    if place of pn in refused > 0
        let nodes = refused[pn]
        if place of nn in nodes > 0
            give back note "looks" - nodes[nn] <= 6
        end
    end
    give back 0
end

# Fresh reads, including failures, are cached once per node in this look.
ritual ask_home look, pn, home, binding
    let node = look["machines"][home]
    if binding
        let fresh = note "fresh nodes"
        if place of home in fresh == 0
            let result = {"error": ""}
            endure
                perform kubectl with "get node " + home + " -o json" into said
                result["node"] = meaning of said
            when it hurts as pain
                result["error"] = "could not read node: " + pain
            end
            let fresh = note "fresh nodes"
            fresh[home] = result
            note "fresh nodes" = fresh
        end
        let result = fresh[home]
        if result["error"] != ""
            give back result["error"]
        end
        node = result["node"]
    end
    perform consent_of with node, look["objects"][pn], note "bonds" into reason
    give back reason
end

ritual refuse_home look, pn, home, reason, binding
    say pn + " is refused by " + home + ": " + reason
    note "waiting" = note "waiting" + 1
    let refused = note "refused"
    perform field with refused, pn, {} into nodes
    nodes[home] = note "looks"
    let refused = note "refused"
    refused[pn] = nodes
    note "refused" = refused
    if binding
        endure
            perform tell_event with look["objects"][pn], "Warning", "Refused", "node " + home + " refused: " + reason, note "scheduler"
        when it hurts as pain
            cry "amaenetes: no event for " + pn + ": " + pain
        end
    end
end

# A look made into the notes `match` reads. The pods of the look are named
# with "#" and the number of the look, so that every look has souls of its own.
ritual prepare look, tail
    perform each_with with look["pods"], tail into pods
    note "pods" = pods
    note "nodes" = look["nodes"]
    let i = 1
    while i <= words of look["pods"]
        note ("likes " + word i of look["pods"] + tail) = look["likes"][word i of look["pods"]]
        recall look tail
        i = i + 1
    end
    i = 1
    while i <= words of look["nodes"]
        let nn = word i of look["nodes"]
        perform each_with with look["likes"][nn], tail into suitors
        note ("likes " + nn) = suitors
        note ("seats " + nn) = look["seats"][nn]
        recall look tail
        i = i + 1
    end
end

# The preferences, line by line, as the world tells them.
ritual hear_preferences first_line
    note "pods" = ""
    note "nodes" = ""
    let line = first_line
    while line != 0
        let name = word 2 of line
        if word 1 of line == "pod"
            note "pods" = note "pods" + " " + name
            perform words_from with line, 3 into likes
            note ("likes " + name) = likes
        end
        if word 1 of line == "node"
            note "nodes" = note "nodes" + " " + name
            note ("seats " + name) = word 3 of line
            perform words_from with line, 4 into likes
            note ("likes " + name) = likes
        end
        hear world into line
    end
end

# A pod with nowhere to live may ask a node to let go of pods that matter
# less than it does, the way kube-scheduler preempts: on the node where the
# going of pods of lower priority makes room for it, the fewest and least
# important of them, every other one kept. A pod that has already been
# promised a node waits there while those it displaced are leaving. Gives
# back {"node": n, "victims": pods}, {"waits": n} or {}.
ritual rescue look, pn
    let pod = look["objects"][pn]
    perform field with pod["spec"], "priority", 0 into mine
    perform field with pod["spec"], "preemptionPolicy", "" into policy
    if policy == "Never"
        give back {}
    end
    perform field with pod["status"], "nominatedNodeName", "" into promised
    if promised != "" and place of promised in look["dying"] > 0
        if look["dying"][promised] > 0
            give back {"waits": promised}
        end
    end
    let chosen = {}
    let chosen_key = []
    let i = 1
    while i <= words of look["nodes"]
        let nn = word i of look["nodes"]
        perform recently_refused with pn, nn into refused
        if place of nn in note "promised nodes" == 0 and not refused
            perform let_go_on with look, pn, mine, nn into tried
            if place of "victims" in tried > 0
                let worst = 0
                let total = 0
                let k = 1
                while k <= length of tried["victims"]
                    perform field with tried["victims"][k]["spec"], "priority", 0 into theirs
                    if theirs > worst or k == 1
                        worst = theirs
                    end
                    total = total + theirs
                    recall tried worst total look pn mine nn chosen chosen_key i
                    k = k + 1
                end
                let key_ = [worst, total, length of tried["victims"], nn]
                let better = length of chosen_key == 0
                if not better
                    perform earlier with key_, chosen_key into better
                end
                if better
                    chosen = {"node": nn, "victims": tried["victims"]}
                    chosen_key = key_
                end
            end
        end
        recall look pn mine chosen chosen_key
        i = i + 1
    end
    give back chosen
end

# Which pods of node `nn` would have to go for `pn` to live there:
# {"victims": pods}, or {} if no going of lower pods makes room.
ritual let_go_on look, pn, mine, nn
    let pod = look["objects"][pn]
    let r = look["wants"][pn]
    let node = look["machines"][nn]
    let residents = look["residents"][nn]
    let lower = []
    let order = []
    let ports = ""
    let left = look["free"][nn]
    let i = 1
    while i <= length of residents
        let q = residents[i]
        perform field with q["spec"], "priority", 0 into theirs
        perform field with q["metadata"], "deletionTimestamp", "" into going
        perform host_ports with q into qp
        if going == "" and theirs < mine
            put q into lower
            put [0 - theirs, q["metadata"]["creationTimestamp"], q["metadata"]["name"]] into order
            perform requests with q into qr
            perform add_up with left, qr into more
            left = more
            if place of "pods" in left > 0
                left["pods"] = left["pods"] + 1
            end
        else
            ports = ports + qp
        end
        recall residents lower order ports left pod r node mine
        i = i + 1
    end
    if length of lower == 0
        give back {}
    end
    perform unfit with pod, node, r, left, ports into reason
    if reason != ""
        give back {}
    end
    perform sorted with lower, order into kept_first
    let victims = []
    i = 1
    while i <= length of kept_first
        let q = kept_first[i]
        perform requests with q into qr
        perform take_away with left, qr into trial
        perform host_ports with q into qp
        perform unfit with pod, node, r, trial, ports + qp into reason
        if reason == ""
            left = trial
            ports = ports + qp
        else
            put q into victims
        end
        recall kept_first victims left ports pod r node
        i = i + 1
    end
    if length of victims == 0
        give back {}
    end
    give back {"victims": victims}
end

# A pod settled on a node this look, among the pods around for the next
# ones of the same look.
ritual settle_near pod, home
    let ar = note "around"
    let placed = ar["placed"]
    put {"pod": pod, "node": home} into placed
    ar["placed"] = placed
    perform pod_terms with pod, "podAntiAffinity", "required" into shuns
    if length of shuns > 0
        let guarded = ar["guarded"]
        put {"pod": pod, "node": home} into guarded
        ar["guarded"] = guarded
    end
    note "around" = ar
end

# Letting go, for `pn`, of the pods a node chose to let go: each is evicted,
# so a disruption budget may still refuse, and told why; `pn` is promised
# the node and waits for the room to be free.
ritual let_go look, pn, saved, binding
    let nn = saved["node"]
    let victims = saved["victims"]
    note "promised nodes" = note "promised nodes" + " " + nn
    note "waiting" = note "waiting" + 1
    let names = ""
    let i = 1
    while i <= length of victims
        names = names + " " + victims[i]["metadata"]["namespace"] + "/" + victims[i]["metadata"]["name"]
        i = i + 1
    end
    say pn + " asks " + nn + " to let go of" + names
    if not binding
        give back 0
    end
    note "victims" = victims
    note "rescued" = look["objects"][pn]
    note "for" = pn
    note "on" = nn
    i = 1
    while i <= length of note "victims"
        let victim = (note "victims")[i]
        let vn = victim["metadata"]["namespace"] + "/" + victim["metadata"]["name"]
        endure
            perform evict with vn
            say vn + " lets go of " + note "on" + " for " + note "for"
            perform tell_event with victim, "Normal", "Preempted", "Preempted by " + note "for" + " on node " + note "on", note "scheduler"
        when it hurts as pain
            say vn + " cannot let go yet: " + pain
        end
        i = i + 1
    end
    endure
        perform nominate with note "rescued", note "on"
    when it hurts as pain
        cry "amaenetes: " + note "for" + " was not promised " + note "on" + ": " + pain
    end
    give back 0
end

# Why a pod has nowhere to live, the way kube-scheduler says it: how many
# nodes there are, and how many of them turned it away for each reason.
# Nodes it fits on but which chose others had no seat left for it.
ritual unavailable look, pn
    let reasons = look["why"][pn]
    let names = keys of reasons
    let told = ""
    let i = 1
    while i <= length of names
        if told != ""
            told = told + ", "
        end
        told = told + reasons[names[i]] + " " + names[i]
        recall reasons names told look pn
        i = i + 1
    end
    let full = words of look["likes"][pn]
    if full > 0
        if told != ""
            told = told + ", "
        end
        told = told + full + " no seat left"
    end
    if look["down"] > 0
        if told != ""
            told = told + ", "
        end
        told = told + look["down"] + " not ready"
    end
    if told == ""
        give back "0/" + look["count"] + " nodes are available."
    end
    give back "0/" + look["count"] + " nodes are available: " + told + "."
end

# Where everyone lives, told; with `binding`, made so in the cluster too.
# Two pods of one look that want the same host port on the same node cannot
# both live there: the second waits for the next look, which will see the
# port taken. How many waited goes to note "waiting".
ritual tell_homes look, tail, binding
    let bound = 0
    let taken = {}
    note "fresh nodes" = {}
    note "waiting" = 0
    note "promised nodes" = ""
    note "around" = look["around"]
    let i = 1
    while i <= words of look["pods"]
        let pn = word i of look["pods"]
        let home = note ("home " + pn + tail)
        perform host_ports with look["objects"][pn] into mine
        let clash = ""
        let crowd = ""
        if home != "nowhere"
            if place of home in taken == 0
                taken[home] = ""
            end
            let k = 1
            while k <= words of mine
                perform port_clash with word k of mine, taken[home] into other
                if other != ""
                    clash = word k of mine
                end
                recall mine taken home look tail binding bound pn i clash crowd
                k = k + 1
            end
            if clash == ""
                let ar = note "around"
                perform sociable with look["objects"][pn] into social
                if social or length of ar["guarded"] > 0
                    perform crowded with look["objects"][pn], look["machines"][home], ar into near
                    crowd = near
                end
            end
        end
        if home == "nowhere"
            perform unavailable with look, pn into why
            say pn + " has nowhere to live: " + why
            if binding
                endure
                    perform tell_event with look["objects"][pn], "Warning", "FailedScheduling", why, note "scheduler"
                when it hurts as pain
                    cry "amaenetes: no event for " + pn + ": " + pain
                end
            end
            perform rescue with look, pn into saved
            if place of "waits" in saved > 0
                say pn + " waits for room on " + saved["waits"]
                note "waiting" = note "waiting" + 1
            end
            if place of "node" in saved > 0
                perform let_go with look, pn, saved, binding
            end
        else
            if clash != "" or crowd != ""
                if clash != ""
                    say pn + " waits for the next look: host port " + clash + " on " + home + " is taken"
                else
                    say pn + " waits for the next look: " + crowd + " on " + home
                end
                note "waiting" = note "waiting" + 1
            else
                perform ask_home with look, pn, home, binding into reason
                recall look tail binding bound taken i pn home mine
                if reason != ""
                    perform refuse_home with look, pn, home, reason, binding
                else
                    taken[home] = taken[home] + mine
                    perform settle_near with look["objects"][pn], home
                    if binding
                        let pod = look["objects"][pn]
                        endure
                            perform bind with pod["metadata"]["namespace"], pod["metadata"]["name"], home into said
                            say pn + " lives on " + home
                            bound = bound + 1
                            note "bound pod" = pod
                            note "bound home" = home
                            endure
                                perform tell_event with note "bound pod", "Normal", "Scheduled", "Successfully assigned " + pn + " to " + note "bound home", note "scheduler"
                            when it hurts as pain
                                cry "amaenetes: no event for " + pn + ": " + pain
                            end
                        when it hurts as pain
                            cry "amaenetes: " + pn + " could not live on " + home + ": " + pain
                        end
                    else
                        say pn + " lives on " + home
                        bound = bound + 1
                    end
                end
            end
        end
        recall look tail binding bound taken
        i = i + 1
    end
    give back bound
end

soul cluster
    note "known nodes" = ""
    note "refused" = {}
    note "looks" = 0
    let scheduler = world "AMAENETES_NAME"
    if scheduler == ""
        scheduler = "amaenetes"
    end
    note "scheduler" = scheduler

    if world "KUBE_CONTEXT" == ""
        hear world into line
        if line != 0 and word 1 of line != "pod" and word 1 of line != "node"
            let all_nodes = (meaning of line)["items"]
            hear world into more
            let all_pods = (meaning of more)["items"]
            hear world into history
            let bonds = {}
            if history != 0
                perform bonds_of with (meaning of history)["items"] into bonds
            end
            perform describe with all_nodes, all_pods, note "scheduler", {}, bonds into look
            perform prepare with look, ""
            perform match
            perform tell_homes with look, "", 0 into bound
        else
            perform hear_preferences with line
            perform match
            note "i" = 1
            while note "i" <= words of note "pods"
                note "p" = word (note "i") of note "pods"
                if note ("home " + note "p") == "nowhere"
                    say note "p" + " has nowhere to live"
                else
                    say note "p" + " lives on " + note ("home " + note "p")
                end
                note "i" = note "i" + 1
            end
        end
        perform farewell
        say "the cluster is at rest"
        goodbye
    end

    # The scheduler of a cluster: it looks, lets everyone find each other,
    # and looks again. A look that would tell the same story as the one
    # before, which bound nobody, is not told again.
    note "looks" = 0
    note "times" = 0
    note "story" = ""
    note "every" = world "AMAENETES_INTERVAL"
    if note "every" == ""
        note "every" = 5
    end
    note "lease" = world "AMAENETES_LEASE"
    note "who" = world "HOSTNAME"
    if note "who" == ""
        note "who" = note "scheduler"
    end
    note "leader" = ""
    say "amaenetes schedules the pods that choose " + note "scheduler"
    mark looking
    if note "lease" != ""
        perform lead
    end
    if note "lease" == "" or note "leader" == note "who"
        perform look_once
    end
    note "times" = note "times" + 1
    if world "AMAENETES_LOOKS" != ""
        if note "times" >= number of world "AMAENETES_LOOKS"
            perform farewell
            goodbye
        end
    end
    wait number of ("" + note "every") seconds
    return to looking
end

# Leading, or waiting for the one who leads: only one scheduler of a name
# binds at a time. Every look renews the lease; one that has not been
# renewed for three looks may be taken.
ritual lead
    perform namespaced with note "lease" into both
    let span = 3 * number of ("" + note "every")
    if span < 15
        span = 15
    end
    endure
        perform hold_lease with both[1], both[2], note "who", span into holder
        note "holder" = holder
    when it hurts as pain
        cry "amaenetes: the lease " + note "lease" + ": " + pain
        note "holder" = ""
    end
    if note "holder" != note "leader"
        if note "holder" == note "who"
            say note "who" + " leads"
        else
            if note "holder" != ""
                say note "who" + " waits: " + note "holder" + " leads"
            end
            note "story" = ""
        end
        note "leader" = note "holder"
    end
end

# One look at the cluster, told if it has something new to tell.
ritual look_once
    note "looks" = note "looks" + 1
    perform prune_refused
    endure
        perform get_all with "nodes" into all_nodes
        perform get_all with "pods -A" into all_pods
        perform get_all with "namespaces" into all_spaces
        let spaces = {}
        let i = 1
        while i <= length of all_spaces
            perform labels_of with all_spaces[i] into sl
            spaces[all_spaces[i]["metadata"]["name"]] = sl
            recall all_spaces spaces all_nodes all_pods
            i = i + 1
        end
        note "bonds" = {}
        endure
            perform get_all with "relationships.amae.io -A" into all_bonds
            perform bonds_of with all_bonds into bonds
            note "bonds" = bonds
        when it hurts as pain
            note "bonds" = {}
        end
        perform describe with all_nodes, all_pods, note "scheduler", spaces, note "bonds" into look
        note "look" = look
    when it hurts as pain
        cry "amaenetes: " + pain
        note "look" = {"pods": ""}
    end
    let look = note "look"
    if words of look["pods"] == 0
        note "story" = ""
    else
        let story = hash of json of [look["likes"], look["seats"]]
        if story != note "story"
            perform prepare with note "look", "#" + note "looks"
            perform match
            perform tell_homes with note "look", "#" + note "looks", 1 into bound
            note "story" = story
            if bound > 0 or note "waiting" > 0
                note "story" = ""
            end
        end
    end
end
