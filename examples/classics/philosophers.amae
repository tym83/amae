# Dining philosophers. Each fork is a soul that belongs to one hand at a time.
# Every philosopher takes the lower-numbered fork first, so nobody starves.
# When the room falls silent, the host lets the forks rest.

written by "amae"
kind philosopher
    meet host
    hear host into one
    tell host "ready"
    hear host into other
    tell host "ready"
    note "one" = one
    note "other" = other
    meet soul named note "one"
    meet soul named note "other"
    note "meals" = 0
    while note "meals" < 3
        tell soul named note "one" "take"
        hear soul named note "one" into ok
        tell soul named note "other" "take"
        hear soul named note "other" into ok
        note "meals" = note "meals" + 1
        say me + " eats, meal " + note "meals"
        tell soul named note "one" "put"
        tell soul named note "other" "put"
    end
end

kind fork
    meet host
    hear host into one
    tell host "ready"
    hear host into other
    tell host "ready"
    note "one" = one
    note "other" = other
    meet soul named note "one"
    meet soul named note "other"
    mark free
    hear anyone into asking from who
    if who == "host"
        goodbye
    end
    note "holder" = who
    tell soul named note "holder" "yours"
    hear soul named note "holder" into returned
    return to free
end

soul host
    let i = 1
    while i <= 5
        bring fork named "fork " + i
        i = i + 1
    end
    i = 1
    while i <= 5
        bring philosopher named "philosopher " + i
        i = i + 1
    end
    i = 1
    while i <= 5
        let left = i - 1
        if i == 1
            left = 5
        end
        let low = left
        let high = i
        if i < left
            low = i
            high = left
        end
        meet soul named ("fork " + i)
        tell soul named ("fork " + i) "philosopher " + low
        hear soul named ("fork " + i) into ready
        tell soul named ("fork " + i) "philosopher " + high
        hear soul named ("fork " + i) into ready
        i = i + 1
    end
    i = 1
    while i <= 5
        let low = i
        let high = i % 5 + 1
        if high < low
            low = high
            high = i
        end
        meet soul named ("philosopher " + i)
        tell soul named ("philosopher " + i) "fork " + low
        hear soul named ("philosopher " + i) into ready
        tell soul named ("philosopher " + i) "fork " + high
        hear soul named ("philosopher " + i) into ready
        i = i + 1
    end
    wait for silence
    i = 1
    while i <= 5
        tell soul named ("fork " + i) "rest"
        i = i + 1
    end
    say "everyone has eaten"
end
