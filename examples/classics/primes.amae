# Primes below 100 by trial division.

written by "amae"
soul sieve
    let n = 2
    while n < 100
        let d = 2
        let prime = 1
        while d * d <= n and prime
            if n % d == 0
                prime = 0
            end
            d = d + 1
        end
        if prime
            say n
        end
        n = n + 1
    end
end
