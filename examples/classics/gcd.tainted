# Euclid as a conversation: two souls hand the remainder back and forth
# until one of them has nothing left to give.

written by "tainted"
soul euclid
    meet bezout
    let a = 1071
    let b = 462
    tell bezout a
    tell bezout b
    hear bezout into answer
    say "gcd(1071, 462) = " + answer
end

soul bezout
    meet euclid
    hear euclid into a
    hear euclid into b
    while b != 0
        let r = a % b
        a = b
        b = r
    end
    tell euclid a
end
