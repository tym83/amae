# Counts lines, words and characters, like wc.

written by "tainted"
soul counter
    let count = 0
    let all = 0
    let characters = 0
    hear world into line
    while line != 0
        count = count + 1
        all = all + words of line
        characters = characters + length of line + 1
        hear world into line
    end
    say count + " " + all + " " + characters
end
