# counsel: the relationships between the workloads Amaenetes schedules
# and the nodes they live on, kept as Relationship objects (amae.io/v1),
# and how they are doing, told the way John Gottman tells it of couples.
#
# A relationship is between a partner (the workload: a Deployment, a
# StatefulSet, a Job, or a bare pod) and a node, in the partner's
# namespace. Every look at the cluster is a moment of their life together:
#   a pod that is ready       a turn towards each other (positive)
#   a restart                 criticism
#   a restart killed for memory   contempt
#   a pod the kubelet refused defensiveness
#   no answer: the pod or the node not ready   stonewalling
# Moments fade: every look keeps 99 of every 100 of them, so what counts is
# the recent life of the two. Gottman found that couples who stay together
# have five positive moments for every negative one; a relationship with a
# ratio of 5 or more is stable, one between 1 and 5 is at risk, and one
# with more negative moments than positive ones is failing. Scars, every
# restart and every refusal, do not fade.
#
# With COUNSEL_DIVORCE=1 it is also a descheduler, and divorces a pod from
# its node, by eviction, so a disruption budget may refuse, at most once
# every COUNSEL_DIVORCE_EVERY looks (6 if not set), and only a pod whose
# workload brings it back:
#   when their relationship is failing (with three scars or more) and the
#   pod could live on a node it is not failing with; or
#   when the pod and another node would both rather be together, the
#   unstable pair of Gale and Shapley: the pod likes that node better
#   (amaenetes.io/likes), fits there, and the node has a seat for it.
# The scheduler then finds the workload's next pod a better home.
#
# Probe bids have three answers: passed (towards), failed (away), and killed
# for failed liveness (against). Attempts are estimated from elapsed time and
# probe periods. Their counts fade like moments, independently of contempt.
# With at least 20 bids, turning below 33% fails, below 86% is at best at risk.
#
# Relationship totals live in the API; look times and Event count baselines
# live in notes and start afresh when counsel restarts. With KUBE_CONTEXT set
# it looks every COUNSEL_INTERVAL seconds (10 if not set), and rests after COUNSEL_LOOKS
# looks if that is set. Pods choose to be counselled by choosing the
# scheduler AMAENETES_NAME (amaenetes if not set).

written by "amae"

deterministic

learn "kube.amae"

# The relationships of the cluster as the API keeps them, by namespace/name.
ritual known_relationships
    perform get_all with "relationships.amae.io -A" into all
    let known = {}
    let i = 1
    while i <= length of all
        known[all[i]["metadata"]["namespace"] + "/" + all[i]["metadata"]["name"]] = all[i]
        recall all known
        i = i + 1
    end
    give back known
end

# Read both Event lists once, keeping only counts still present in the API.
# The first successful read only establishes a baseline after each restart.
# Pod UIDs keep an old pod's Events from following a replacement with its name.
ritual bid_events
    perform get_all with "events -A --field-selector reason=Unhealthy" into unhealthy
    perform get_all with "events -A --field-selector reason=Killing" into killing
    let events_ = unhealthy + killing
    let counts = {}
    let answers = {}
    let previous = note "event counts"
    let i = 1
    while i <= length of events_
        let e = events_[i]
        let uid = e["metadata"]["uid"]
        perform field with e, "count", 1 into count_
        perform field with previous, uid, 0 into prior
        counts[uid] = count_
        let delta = count_ - prior
        if not note "event baseline ready"
            delta = 0
        end
        perform field with e, "message", "" into message
        let answer = ""
        if e["reason"] == "Unhealthy"
            if part 1 21 of message == "Liveness probe failed" or part 1 22 of message == "Readiness probe failed"
                answer = "away"
            end
        else
            let j = 1
            while j <= length of message - 20
                if part j (j + 20) of message == "failed liveness probe"
                    answer = "against"
                end
                recall events_ counts answers previous i e uid delta message answer
                j = j + 1
            end
        end
        perform field with e, "involvedObject", {} into involved
        perform field with involved, "kind", "" into object_kind
        perform field with involved, "uid", "" into pod_uid
        if answer != "" and delta > 0 and object_kind == "Pod" and pod_uid != ""
            perform field with answers, pod_uid, {"away": 0, "against": 0} into a
            a[answer] = a[answer] + delta
            answers[pod_uid] = a
        end
        recall events_ counts answers previous
        i = i + 1
    end
    note "event counts" = counts
    note "event baseline ready" = 1
    note "bid answers" = answers
end

# Estimated probe attempts since this pod's last look. First sight is capped
# to one interval; fractional attempts survive the usual two-decimal rounding.
ritual bids_of p
    perform field with p["metadata"], "uid", p["metadata"]["namespace"] + "/" + p["metadata"]["name"] into uid
    let last = note "pod looks"
    let at = note "look time"
    let elapsed = 0
    if place of uid in last > 0
        elapsed = at - last[uid]
    else
        perform field with p["status"], "startTime", "" into started
        if started != ""
            perform seconds_of with started into began
            elapsed = at - began
            if elapsed > number of ("" + note "every")
                elapsed = number of ("" + note "every")
            end
        end
    end
    if elapsed < 0
        elapsed = 0
    end
    let current = note "current pod looks"
    current[uid] = at
    note "current pod looks" = current
    let total = 0
    perform field with p["spec"], "containers", [] into containers
    let probes = ["livenessProbe", "readinessProbe"]
    let i = 1
    while i <= length of containers
        let j = 1
        while j <= length of probes
            if place of probes[j] in containers[i] > 0
                perform field with containers[i][probes[j]], "periodSeconds", 10 into period
                if period > 0
                    total = total + elapsed / (period * 1.0)
                end
            end
            recall containers probes i elapsed total uid
            j = j + 1
        end
        recall containers probes elapsed total uid
        i = i + 1
    end
    let answers = note "bid answers"
    perform field with answers, uid, {"away": 0, "against": 0} into a
    a["bids"] = total
    a["towards"] = total - a["away"] - a["against"]
    if a["towards"] < 0
        a["towards"] = 0
    end
    give back a
end

# What happened between one pod and its node in this look, added to what
# happened between its partner and the node.
ritual observe p, node_ready, known
    perform partner_of with p into partner
    let ns = p["metadata"]["namespace"]
    let node = p["spec"]["nodeName"]
    perform lowered with partner["kind"] into kind_
    let name = kind_ + "-" + partner["name"] + "." + node
    let key_ = ns + "/" + name
    let seen = note "seen"
    let o = {"namespace": ns, "name": name, "partner": partner, "node": node, "positive": 0, "criticism": 0, "contempt": 0, "defensiveness": 0, "stonewalling": 0, "pods": {}, "told": [], "bids": 0, "towards": 0, "away": 0, "against": 0}
    if place of key_ in seen > 0
        o = seen[key_]
    end
    let earlier_pods = {}
    if place of key_ in known > 0
        perform field with known[key_], "status", {} into st
        perform field with st, "pods", {} into earlier_pods
    end
    let pn = p["metadata"]["name"]
    let was = {"restarts": 0, "refused": 0}
    if place of pn in earlier_pods > 0
        was = earlier_pods[pn]
    end
    perform restarts_of with p into r
    let now_ = {"restarts": r["restarts"], "refused": was["refused"]}
    if r["restarts"] > was["restarts"]
        let more = r["restarts"] - was["restarts"]
        if r["oom"]
            o["contempt"] = o["contempt"] + more
            o["told"] = o["told"] + ["contempt: " + pn + " was killed for memory"]
        else
            o["criticism"] = o["criticism"] + more
            o["told"] = o["told"] + ["criticism: " + pn + " restarted"]
        end
    end
    perform field with p["status"], "phase", "" into stage
    perform field with p["status"], "reason", "" into why
    if stage == "Failed" and why != "" and why != "Evicted" and not was["refused"]
        o["defensiveness"] = o["defensiveness"] + 1
        o["told"] = o["told"] + ["defensiveness: the node refused " + pn + ": " + why]
        now_["refused"] = 1
    end
    if stage == "Running"
        perform condition_of with p, "Ready" into up
        if up and node_ready
            o["positive"] = o["positive"] + 1
        else
            o["stonewalling"] = o["stonewalling"] + 1
        end
    end
    perform bids_of with p into bids_
    let bid_names = ["bids", "towards", "away", "against"]
    let bi = 1
    while bi <= length of bid_names
        o[bid_names[bi]] = o[bid_names[bi]] + bids_[bid_names[bi]]
        recall o bids_ bid_names pn now_ key_
        bi = bi + 1
    end
    if bids_["away"] > 0
        o["told"] = o["told"] + [pn + " turned away from " + bids_["away"] + " bids"]
    end
    if bids_["against"] > 0
        o["told"] = o["told"] + [pn + " turned against " + bids_["against"] + " bids: killed for a failed liveness probe"]
    end
    let pods = o["pods"]
    pods[pn] = now_
    o["pods"] = pods
    seen = note "seen"
    seen[key_] = o
    note "seen" = seen
end

# How a relationship is doing, from its moments.
ritual health_of positive, negative
    if negative < 0.01
        give back "stable"
    end
    if positive >= 5 * negative
        give back "stable"
    end
    if positive >= negative
        give back "at risk"
    end
    give back "failing"
end

ritual rounded x
    give back whole of (x * 100 + 0.5) / 100.0
end

# A relationship as it is now: what it was, faded by one look, and what
# this look added. Gives back the object and whether it is worth writing.
ritual relate o, known, looks
    let key_ = o["namespace"] + "/" + o["name"]
    let old = {}
    let body = {"apiVersion": "amae.io/v1", "kind": "Relationship", "metadata": {"name": o["name"], "namespace": o["namespace"]}, "spec": {"partner": o["partner"], "node": o["node"]}}
    if place of key_ in known > 0
        body = known[key_]
        perform field with body, "status", {} into old
    end
    # What this counsel counted since it last wrote is newer than the API.
    let kept = note "kept"
    if place of key_ in kept > 0
        old = kept[key_]
    end
    let st = {}
    let fresh = 0
    let names = ["positive", "criticism", "contempt", "defensiveness", "stonewalling"]
    let negative = 0
    let i = 1
    while i <= length of names
        perform field with old, names[i], 0 into was
        perform rounded with was * 0.99 + o[names[i]] into made
        st[names[i]] = made
        if i > 1
            negative = negative + made
            if o[names[i]] > 0
                fresh = 1
            end
        end
        recall names st old o negative fresh body key_ known looks
        i = i + 1
    end
    perform field with old, "scars", 0 into carried
    st["scars"] = carried + o["criticism"] + o["contempt"] + o["defensiveness"]
    perform health_of with st["positive"], negative into health
    names = ["bids", "towards", "away", "against"]
    i = 1
    while i <= length of names
        perform field with old, names[i], 0 into was
        perform rounded with was * 0.99 + o[names[i]] into made
        st[names[i]] = made
        recall names old o st health fresh body key_ looks negative
        i = i + 1
    end
    if o["away"] > 0 or o["against"] > 0
        fresh = 1
    end
    if st["bids"] > 0
        st["turning"] = whole of (100 * st["towards"] / st["bids"])
        if st["bids"] >= 20
            if st["turning"] < 33
                health = "failing"
            else
                if st["turning"] < 86 and health == "stable"
                    health = "at risk"
                end
            end
        end
    end
    st["health"] = health
    if negative >= 0.01
        perform rounded with st["positive"] / negative into ratio
        st["ratio"] = "" + ratio
    else
        st["ratio"] = "-"
    end
    perform field with old, "health", "" into was_health
    if health != was_health
        fresh = 1
    end
    perform stamp_of with now into stamp
    st["lastSeen"] = stamp
    perform field with old, "history", [] into history
    i = 1
    while i <= length of o["told"]
        history = history + [{"at": stamp, "what": o["told"][i]}]
        recall o history stamp st fresh body key_ looks health was_health
        i = i + 1
    end
    while length of history > 10
        let rest = []
        let k = 2
        while k <= length of history
            put history[k] into rest
            recall history rest o st fresh body key_ looks health was_health
            k = k + 1
        end
        history = rest
    end
    st["history"] = history
    st["pods"] = o["pods"]
    body["status"] = st
    # Read again: a list kept across the loops above would have faded.
    let remembered = note "kept"
    remembered[key_] = st
    note "kept" = remembered
    if place of "resourceVersion" in body["metadata"] == 0
        fresh = 1
    end
    give back {"body": body, "fresh": fresh or looks % 6 == 0, "health": health, "was": was_health}
end

ritual write_relationship body
    let ns = body["metadata"]["namespace"]
    let where = "/apis/amae.io/v1/namespaces/" + ns + "/relationships"
    if place of "resourceVersion" in body["metadata"] > 0
        perform kubectl_telling with "replace --raw " + where + "/" + body["metadata"]["name"] + " -f -", json of body into said
    else
        perform kubectl_telling with "create --raw " + where + " -f -", json of body into said
    end
    give back said
end

# One look at the cluster: every pod of the scheduler that lives somewhere
# is a moment of its partner's relationship with the node.
ritual counsel_once
    note "look time" = now
    note "current pod looks" = {}
    perform bid_events
    perform get_all with "nodes" into all_nodes
    perform get_all with "pods -A" into all_pods
    note "nodes" = all_nodes
    note "pods" = all_pods
    perform known_relationships into known
    note "known" = known
    let up = {}
    let i = 1
    while i <= length of all_nodes
        perform ready with all_nodes[i] into ok
        up[all_nodes[i]["metadata"]["name"]] = ok
        recall all_nodes all_pods up
        i = i + 1
    end
    note "seen" = {}
    i = 1
    while i <= length of all_pods
        let p = all_pods[i]
        perform field with p["spec"], "schedulerName", "" into chosen
        perform field with p["spec"], "nodeName", "" into where
        if chosen == note "scheduler" and where != ""
            let node_ready = 0
            if place of where in up > 0
                node_ready = up[where]
            end
            perform observe with p, node_ready, note "known"
        end
        recall all_pods up
        i = i + 1
    end
    note "pod looks" = note "current pod looks"
    let seen = note "seen"
    let keys_ = keys of seen
    i = 1
    while i <= length of keys_
        perform relate with seen[keys_[i]], note "known", note "looks" into made
        note "made" = made
        if made["health"] != made["was"]
            let b = made["body"]
            say b["metadata"]["namespace"] + "/" + b["metadata"]["name"] + " is " + made["health"] + " (" + b["status"]["positive"] + " positive, ratio " + b["status"]["ratio"] + ", scars " + b["status"]["scars"] + ")"
        end
        if made["fresh"]
            endure
                perform write_relationship with (note "made")["body"]
            when it hurts as pain
                cry "counsel: " + pain
            end
        end
        recall seen keys_
        i = i + 1
    end
end

# How the relationship `key_` is doing: as counted in this look, else as
# the API keeps it (the partner may not live on that node now), else "".
ritual health_with key_
    let kept = note "kept"
    if place of key_ in kept > 0
        perform field with kept[key_], "health", "" into health
        give back health
    end
    let known = note "known"
    if place of key_ in known > 0
        perform field with known[key_], "status", {} into st
        perform field with st, "health", "" into health
        give back health
    end
    give back ""
end

# Whether two who live together should part, and where the pod would go.
ritual divorce_once all_nodes, all_pods
    let free = {}
    let ports = {}
    let ours = {}
    let machines = {}
    let i = 1
    while i <= length of all_nodes
        perform ready with all_nodes[i] into up
        if up
            let name = all_nodes[i]["metadata"]["name"]
            perform allocatable with all_nodes[i] into left
            free[name] = left
            ports[name] = ""
            ours[name] = 0
            machines[name] = all_nodes[i]
        end
        recall all_nodes all_pods free ports ours machines
        i = i + 1
    end
    let movable = []
    i = 1
    while i <= length of all_pods
        let p = all_pods[i]
        perform field with p["spec"], "nodeName", "" into where
        perform field with p["status"], "phase", "" into stage
        if where != "" and place of where in free > 0 and stage != "Succeeded" and stage != "Failed"
            perform requests with p into r
            perform take_away with free[where], r into left
            free[where] = left
            perform host_ports with p into hp
            ports[where] = ports[where] + hp
            perform field with p["spec"], "schedulerName", "" into chosen
            perform field with p["metadata"], "deletionTimestamp", "" into going
            if chosen == note "scheduler"
                ours[where] = ours[where] + 1
                perform partner_of with p into partner
                if partner["kind"] != "Pod" and stage == "Running" and going == ""
                    put p into movable
                end
            end
        end
        recall all_pods free ports ours machines movable
        i = i + 1
    end
    let kept = note "kept"
    let nodes = keys of machines
    i = 1
    while i <= length of movable
        let p = movable[i]
        let here = p["spec"]["nodeName"]
        perform partner_of with p into partner
        perform lowered with partner["kind"] into kind_
        let ns = p["metadata"]["namespace"]
        let stem = ns + "/" + kind_ + "-" + partner["name"] + "."
        perform requests with p into r
        let why = ""
        let target = ""
        let st = {}
        if place of (stem + here) in kept > 0
            st = kept[stem + here]
        end
        perform field with st, "health", "" into health
        perform field with st, "scars", 0 into carried
        if health == "failing" and carried >= 3
            let j = 1
            while j <= length of nodes and target == ""
                let m = nodes[j]
                perform health_with with stem + m into theirs
                if m != here and theirs != "failing"
                    perform unfit with p, machines[m], r, free[m], ports[m] into no
                    if no == ""
                        target = m
                        why = "their relationship is failing (" + carried + " scars)"
                    end
                end
                recall j nodes kept stem here p r machines free ports target why carried
                j = j + 1
            end
        end
        if target == ""
            perform annotation with p, "amaenetes.io/likes" into wanted
            let mine = place of here in wanted
            if mine == 0
                mine = words of wanted + 1
            end
            let j = 1
            while j < mine and target == ""
                let m = word j of wanted
                if place of m in machines > 0
                    perform unfit with p, machines[m], r, free[m], ports[m] into no
                    perform annotation with machines[m], "amaenetes.io/seats" into limit
                    let room = 1
                    if limit != ""
                        room = number of limit - ours[m]
                    end
                    if no == "" and room > 0
                        target = m
                        why = "it would rather live on " + m + ", and " + m + " has a seat for it"
                    end
                end
                recall j mine wanted p r machines free ports ours target why here
                j = j + 1
            end
        end
        if target != ""
            let pn = ns + "/" + p["metadata"]["name"]
            note "divorced" = p
            note "why" = why
            note "here" = here
            endure
                perform evict with pn
                say pn + " parts from " + note "here" + ": " + note "why"
                perform tell_event with note "divorced", "Normal", "Divorced", "Parted from " + note "here" + ": " + note "why", "counsel"
            when it hurts as pain
                say pn + " cannot part from " + note "here" + " yet: " + pain
            end
            give back 1
        end
        recall movable kept nodes machines free ports ours
        i = i + 1
    end
    give back 0
end

soul counsel
    note "scheduler" = world "AMAENETES_NAME"
    if note "scheduler" == ""
        note "scheduler" = "amaenetes"
    end
    note "every" = world "COUNSEL_INTERVAL"
    if note "every" == ""
        note "every" = 10
    end
    note "looks" = 0
    note "kept" = {}
    note "event counts" = {}
    note "event baseline ready" = 0
    note "pod looks" = {}
    note "divorce every" = 6
    if world "COUNSEL_DIVORCE_EVERY" != ""
        note "divorce every" = number of world "COUNSEL_DIVORCE_EVERY"
    end
    say "counsel looks after the relationships of the pods that choose " + note "scheduler"
    mark looking
    endure
        perform counsel_once
        if world "COUNSEL_DIVORCE" == "1" and note "looks" % note "divorce every" == 0
            perform divorce_once with note "nodes", note "pods"
        end
    when it hurts as pain
        cry "counsel: " + pain
    end
    note "looks" = note "looks" + 1
    if world "COUNSEL_LOOKS" != ""
        if note "looks" >= number of world "COUNSEL_LOOKS"
            goodbye
        end
    end
    wait number of ("" + note "every") seconds
    return to looking
end
