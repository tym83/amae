#!/bin/sh
# tc: compile a Amae program into a program of its own.
#
#   tc program.amae              builds ./program
#   tc program.amae -o path      builds path
#   tc program.amae -c           only says the C
#   tc compiler.amae --give-heart  the heart of the compiler, rebuilt
#
# The compiler itself is build/tc-core, made from the seed by `make`.
set -e
home=${AMAE_HOME:-$(cd "$(dirname "$0")/.." && pwd)}
core=${AMAE_CORE:-$home/build/tc-core}
cc=${CC:-cc}
if [ $# -lt 1 ]; then
    echo "usage: tc program.amae [-o output | -c]" >&2
    exit 64
fi
source=$1
shift
output=$(basename "$source" .amae)
only_c=0
while [ $# -gt 0 ]; do
    case $1 in
        -o) output=$2; shift 2 ;;
        -c) only_c=1; shift ;;
        --give-heart) AMAE_GIVE_HEART=1; export AMAE_GIVE_HEART; shift ;;
        --forgive) AMAE_FORGIVE=1; export AMAE_FORGIVE; shift ;;
        *) echo "tc: unknown option $1" >&2; exit 64 ;;
    esac
done
if [ ! -x "$core" ]; then
    echo "tc: no compiler at $core; run make in $home" >&2
    exit 1
fi
AMAE_DIR=$(cd "$(dirname "$source")" && pwd)
AMAE_LIB=${AMAE_LIB:-$home/lib}
export AMAE_DIR AMAE_LIB
if [ $only_c = 1 ]; then
    exec "$core" < "$source"
fi
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
"$core" < "$source" > "$work/program.c"
"$cc" -std=c11 -D_POSIX_C_SOURCE=200809L -D_DEFAULT_SOURCE -O2 -w -I"$home/runtime" \
    "$work/program.c" "$home/runtime/amae.c" -o "$output" -lm
