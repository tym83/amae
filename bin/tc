#!/bin/sh
# tc: compile a Tainted program into a program of its own.
#
#   tc program.tainted              builds ./program
#   tc program.tainted -o path      builds path
#   tc program.tainted -c           only says the C
#   tc compiler.tainted --give-heart  the heart of the compiler, rebuilt
#
# The compiler itself is build/tc-core, made from the seed by `make`.
set -e
home=${TAINTED_HOME:-$(cd "$(dirname "$0")/.." && pwd)}
core=${TAINTED_CORE:-$home/build/tc-core}
cc=${CC:-cc}
if [ $# -lt 1 ]; then
    echo "usage: tc program.tainted [-o output | -c]" >&2
    exit 64
fi
source=$1
shift
output=$(basename "$source" .tainted)
only_c=0
while [ $# -gt 0 ]; do
    case $1 in
        -o) output=$2; shift 2 ;;
        -c) only_c=1; shift ;;
        --give-heart) TAINTED_GIVE_HEART=1; export TAINTED_GIVE_HEART; shift ;;
        --forgive) TAINTED_FORGIVE=1; export TAINTED_FORGIVE; shift ;;
        *) echo "tc: unknown option $1" >&2; exit 64 ;;
    esac
done
if [ ! -x "$core" ]; then
    echo "tc: no compiler at $core; run make in $home" >&2
    exit 1
fi
TAINTED_DIR=$(cd "$(dirname "$source")" && pwd)
TAINTED_LIB=${TAINTED_LIB:-$home/lib}
export TAINTED_DIR TAINTED_LIB
if [ $only_c = 1 ]; then
    exec "$core" < "$source"
fi
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
"$core" < "$source" > "$work/program.c"
"$cc" -std=c11 -D_POSIX_C_SOURCE=200809L -D_DEFAULT_SOURCE -O2 -w -I"$home/runtime" \
    "$work/program.c" "$home/runtime/tainted.c" -o "$output" -lm
