written by "amae"

ritual gcd a, b
    while b != 0
        let r = a % b
        a = b
        b = r
    end
    give back a
end

ritual factorial n
    if n <= 1
        give back 1
    end
    perform factorial with n - 1 into smaller
    give back n * smaller
end

soul mathematician
    perform gcd with 1071, 462 into g
    say "gcd: " + g
    perform factorial with 20 into f
    say "20! = " + f
end
