# generated by tools/minsky.py
soul machine
    meet x
    meet y
    warm to x
    warm to x
    warm to x
    warm to x
    warm to x
    return to at_s0
    mark at_s0
    if trust x == 0
        return to at_s0
    end
    cool to x
    return to at_s1
    mark at_s1
    if trust x == 0
        return to at_stop
    end
    cool to x
    return to at_s1
    mark at_stop
    say "x = " + trust x
    say "y = " + trust y
    goodbye
end

soul x
    meet machine
end

soul y
    meet machine
end
