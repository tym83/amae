written by "amae"

kind worker
    meet anyone as boss
    hear soul named boss into task
    tell soul named boss task + " squared is " + task * task
end

soul boss
    let i = 1
    while i <= 3
        bring worker named "worker " + i
        i = i + 1
    end
    i = 1
    while i <= 3
        meet soul named ("worker " + i)
        tell soul named ("worker " + i) i + 1
        i = i + 1
    end
    i = 1
    while i <= 3
        hear anyone into result from who
        say who + ": " + result
        i = i + 1
    end
end
